<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Задержка записи видео"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выберите задержку перед началом видеозаписи:"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/video_delay_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/delay_600ms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.6с — быстро"
            android:textSize="16sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/delay_800ms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.8с — по умолчанию"
            android:textSize="16sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/delay_1000ms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0с — средняя"
            android:textSize="16sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/delay_2000ms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.0с — долгая"
            android:textSize="16sp"
            android:padding="8dp"/>

    </RadioGroup>

</LinearLayout>
