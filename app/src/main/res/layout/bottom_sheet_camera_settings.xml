<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки камеры"
        android:textSize="20sp"
        android:textStyle="bold" 
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Режим вспышки"
        android:textSize="16sp"/>

    <RadioGroup
        android:id="@+id/flash_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/flash_mode_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Авто"/>

        <RadioButton
            android:id="@+id/flash_mode_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вкл"/>

        <RadioButton
            android:id="@+id/flash_mode_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выкл"/>

    </RadioGroup>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/timestamp_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Штамп даты и времени на фото" />

</LinearLayout>
