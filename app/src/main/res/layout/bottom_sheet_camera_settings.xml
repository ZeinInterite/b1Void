<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки камеры"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/flash_settings_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Режим вспышки"
        android:textAlignment="textStart"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/resolution_settings_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Разрешение камеры"
        android:textAlignment="textStart"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/video_delay_settings_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Задержка записи видео"
        android:textAlignment="textStart"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

</LinearLayout>
